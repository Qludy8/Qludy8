# Port HTTP
PORT=4747
# Fichier SQLite (créé automatiquement)
DB_FILE=data/armaris.db
# URL publique du site (sert à construire l'URL de retour Discord)
PUBLIC_URL=http://localhost:3000
# Vérification Discord (https://discord.com/developers/applications → OAuth2)
# Redirect à déclarer dans Discord : ${PUBLIC_URL}/api/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# En local sans application Discord : bouton de vérification simulée
DISCORD_DEV_MOCK=0
# Bots marchands (0 pour désactiver) et cadence en ms
BOTS=1
BOT_TICK_MS=90000
NODE_ENV=development
